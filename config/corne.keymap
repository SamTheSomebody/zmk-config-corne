#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define FAST_UP    MOVE(0, -1200)
#define FAST_DOWN  MOVE(0, 1200)
#define FAST_LEFT  MOVE(-1200, 0)
#define FAST_RIGHT MOVE(1200, 0)

#define BASE    0
#define LOWER   1
#define RAISE   2
#define FN      3

#define SNIP_WIN  LG(LS(S))

/ {
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <LOWER RAISE>;
                        then-layer = <FN>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "DEFAULT";
// ------------------------------------------------------------------------------------------------
// |  TAB  |   Q   |   W   |   E   |   R   |   T   |   |   Y   |   U   |   I   |   O   |   P   | BSPC |
// |  CTRL |   A   |   S   |   D   |   F   |   G   |   |   H   |   J   |   K   |   L   |   ;   |   '  |
// |  SHFT |   Z   |   X   |   C   |   V   |   B   |   |   N   |   M   |   ,   |   .   |   /   |  ALT |
//                         |  GUI  |  LWR  |  SPC  |   |  ENT  |  RSE  |  ESC  |
                        bindings = <
   &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
   &kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
   &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RALT
                                 &kp LGUI  &mo LOWER &kp SPACE    &kp RET   &mo RAISE &kp ESC
                        >;
                };

                lower_layer {
                        display-name = "NUMBER";
// ------------------------------------------------------------------------------------------------
// | S(TAB)|       |  HOME |   ^   |  END  |  DEL  |   |   /   |   7   |   8   |   9   |   -   |      |
// |       |       |   <   |   v   |   >   |  INS  |   |   *   |   4   |   5   |   6   |   +   |   =  |
// |  CAPS |       |       |       |       |       |   |   .   |   1   |   2   |   3   |   0   |      |
//                         |       |       |       |   |       |       |       |
                        bindings = <
   &kp LS(TAB) &trans    &kp HOME  &kp UP    &kp END   &kp DEL      &kp FSLH  &kp N7    &kp N8    &kp N9    &kp MINUS &trans
   &trans      &trans    &kp LEFT  &kp DOWN  &kp RIGHT &kp INS      &kp ASTRK &kp N4    &kp N5    &kp N6    &kp PLUS  &kp EQUAL
   &kp CAPSLOCK &trans   &trans    &trans    &trans    &trans       &kp DOT   &kp N1    &kp N2    &kp N3    &kp N0    &trans
                                   &trans    &trans    &trans       &trans    &trans    &trans
                        >;
                };

                raise_layer {
                        display-name = "SYMBOL";
// ------------------------------------------------------------------------------------------------
// |   _   |   -   |   <   |   >   |   {   |   }   |   |   =   |   &   |   *   |   +   |       |      |
// |   |   |   `   |   '   |   "   |   [   |   ]   |   |   ~   |   $   |   %   |   ^   |       |      |
// |   /   |   \   |   :   |   ;   |   (   |   )   |   |   ?   |   !   |   @   |   #   |       |      |
//                         |       |       |       |   |       |       |       |
                        bindings = <
   &kp UNDER  &kp MINUS &kp LT    &kp GT    &kp LBRC  &kp RBRC     &kp EQUAL &kp AMPS  &kp ASTRK &kp PLUS  &trans    &trans
   &kp PIPE   &kp GRAVE &kp SQT   &kp DQT   &kp LBKT  &kp RBKT     &kp TILDE &kp DLLR  &kp PRCNT &kp CARET &trans    &trans
   &kp FSLH   &kp BSLH  &kp COLON &kp SEMI  &kp LPAR  &kp RPAR     &kp QMARK &kp EXCL  &kp AT    &kp HASH  &trans    &trans
                                 &trans    &trans    &trans       &trans    &trans    &trans
                        >;
                };

                function_layer {
                        display-name = "FUNCTION";
// ------------------------------------------------------------------------------------------------
// | BTCLR | BTPRV | BTNXT | PREV  |  PP   | NEXT  |   | MCLK  |  MLFT |  MDWN |  MUP  |  MRGT | HOME |
// |  STU  |  BLE  |  USB  | MUTE  | VOLDN | VOLUP |   | LCLK  |  MLFT |  MDWN |  MUP  |  MRGT | PGUP |
// |  OFF  | CSLEP | KLOCK |  SNIP | BRIDN | BRIUP |   | RCLK  |  SLFT |  SDWN |  SUP  |  SRGT | PGDN |
//                         |       |       |       |   |       |       |       |
                        bindings = <
   &bt BT_CLR      &bt BT_PRV    &bt BT_NXT    &kp C_PREV    &kp C_PP      &kp C_NEXT         &mkp MCLK  &mmv FAST_LEFT  &mmv FAST_DOWN  &mmv FAST_UP  &mmv FAST_RIGHT  &kp HOME
   &studio_unlock  &out OUT_BLE  &out OUT_USB  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP       &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp PG_UP
   &soft_off       &kp C_SLEEP   &kp K_LOCK    &kp SNIP_WIN  &kp C_BRI_DN  &kp C_BRI_UP       &mkp RCLK  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp PG_DN
                                               &trans        &trans        &trans             &trans     &trans          &trans
                        >;
                };
        };
};
